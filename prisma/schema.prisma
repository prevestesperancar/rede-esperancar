// Rede Esperançar — schema principal
// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ESTUDANTE
  PROFESSOR
  COORDENACAO
  APOIO_PSICOSSOCIAL
  ADMIN
}

enum StatusInscricao {
  PENDENTE
  APROVADA
  RECUSADA
}

enum StatusEstudante {
  EM_AVALIACAO
  PRESENTE
  FALTANTE
  DESISTENTE
  TRANSFERIDO
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  role               Role
  nome               String
  telefone           String?
  fotoUrl            String?
  materia            String?
  precisaTrocarSenha Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // null quando role = ADMIN (visão global, não escopada a um núcleo)
  nucleoId String?
  nucleo   Nucleo? @relation("UsuariosDoNucleo", fields: [nucleoId], references: [id])

  estudante                 Estudante?
  disciplinasQueLeciona     TurmaDisciplina[]
  nucleosQueCoordena        Nucleo[]                 @relation("CoordenadorDoNucleo")
  monitoriasComoProfessor   Monitoria[]
  solicitacoesComoProfessor SolicitacaoAgendamento[] @relation("SolicitacaoProfessor")
  solicitacoesRespondidas   SolicitacaoAgendamento[] @relation("SolicitacaoRespondidoPor")
  temasRedacaoCriados       TemaRedacao[]            @relation("TemasCriados")
  redacoesCorrigidas        Redacao[]                @relation("RedacoesCorrigidas")
  notificacoes              Notificacao[]

  @@index([nucleoId])
}

model Notificacao {
  id        String   @id @default(cuid())
  userId    String
  tipo      String
  mensagem  String
  link      String?
  lida      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, lida])
}

model GaleriaEvento {
  id           String   @id @default(cuid())
  imagemUrl    String?
  instagramUrl String?
  legenda      String?
  data         DateTime @default(now())
  createdAt    DateTime @default(now())

  nucleoId String?
  nucleo   Nucleo? @relation(fields: [nucleoId], references: [id])

  @@index([nucleoId])
}

model CronogramaConclusao {
  id          String   @id @default(cuid())
  estudanteId String
  chave       String // ex: "2025-W07-sabado-Matematica"
  concluidoEm DateTime @default(now())

  estudante Estudante @relation(fields: [estudanteId], references: [id])

  @@unique([estudanteId, chave])
}

model Nucleo {
  id                     String   @id @default(cuid())
  nome                   String
  slug                   String   @unique
  cidade                 String
  estado                 String
  bairro                 String
  endereco               String?
  descricao              String?
  fotoUrl                String?
  instagram              String?
  googleSheetsUrl        String?
  linkMonitoriaProfessor String?
  linkApoioPsicossocial  String?
  latitude               Float?
  longitude              Float?
  ativo                  Boolean  @default(true)
  createdAt              DateTime @default(now())

  coordenadorId String?
  coordenador   User?   @relation("CoordenadorDoNucleo", fields: [coordenadorId], references: [id])

  usuarios                User[]                   @relation("UsuariosDoNucleo")
  turmas                  Turma[]
  materiais               Material[]
  avisos                  Aviso[]
  simulados               Simulado[]
  eventos                 Evento[]
  provas                  Prova[]
  depoimentos             Depoimento[]
  monitorias              Monitoria[]
  formularios             FormularioCustom[]
  solicitacoesAgendamento SolicitacaoAgendamento[]
  galeriaEventos          GaleriaEvento[]
}

enum TipoSolicitacao {
  MONITORIA
  APOIO
}

enum StatusSolicitacao {
  PENDENTE
  AGUARDANDO_ESCOLHA
  CONFIRMADO
  CANCELADO
}

model SolicitacaoAgendamento {
  id     String            @id @default(cuid())
  tipo   TipoSolicitacao
  status StatusSolicitacao @default(PENDENTE)

  mensagem String?

  opcao1      DateTime?
  opcao2      DateTime?
  opcao3      DateTime?
  escolhaData DateTime?

  createdAt    DateTime  @default(now())
  respondidoEm DateTime?
  confirmadoEm DateTime?

  estudanteId String
  estudante   Estudante @relation(fields: [estudanteId], references: [id])

  nucleoId String
  nucleo   Nucleo @relation(fields: [nucleoId], references: [id])

  professorId String?
  professor   User?   @relation("SolicitacaoProfessor", fields: [professorId], references: [id])

  respondidoPorId String?
  respondidoPor   User?   @relation("SolicitacaoRespondidoPor", fields: [respondidoPorId], references: [id])

  @@index([nucleoId])
  @@index([professorId])
  @@index([estudanteId])
}

model Turma {
  id           String  @id @default(cuid())
  nome         String
  periodo      String
  capacidade   Int
  whatsappLink String?
  ativo        Boolean @default(true)

  nucleoId String
  nucleo   Nucleo @relation(fields: [nucleoId], references: [id])

  matriculas  Matricula[]
  disciplinas TurmaDisciplina[]
  avisos      Aviso[]
  frequencias Frequencia[]
  monitorias  Monitoria[]

  @@index([nucleoId])
}

model Estudante {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  status              StatusEstudante @default(EM_AVALIACAO)
  ultimoContato       DateTime?
  ultimoContatoObs    String?
  observacoesInternas String?
  bolsista            Boolean?

  // Dados coletados na inscrição (não sensíveis — CPF/RG/dados bancários ficam só na planilha)
  dataNascimento        DateTime?
  sexoGenero            String?
  racaCor               String?
  bairro                String?
  municipio             String?
  situacaoEscolar       String?
  escola                String?
  escolaPublica         Boolean?
  cotista               Boolean?
  jaFezEnem             Boolean?
  cursoDesejado         String?
  universidadeDesejada  String?
  disponibilidadeSabado Boolean?
  provasQueVaiFazer     String?
  rendaFamiliar         String?
  pessoasEmCasa         Int?
  trabalha              Boolean?
  motivacao             String?

  // Perfil do Banco de Questões — preenchido no onboarding, ajustável depois
  perfilIntensidade String? // "SEM_PRESSAO" | "EQUILIBRISTA" | "MONSTRAO"
  linguaEstrangeira String? // "Inglês" | "Espanhol"
  questoesPorDia    Int?
  objetivoEstudo    String? // "PASSAR_ENEM_ANO" | "TREINO_ENEM" | "MANDAR_BEM_ESCOLA" | "AINDA_NAO_SEI"

  matriculas              Matricula[]
  frequencias             Frequencia[]
  redacoes                Redacao[]
  simulados               SimuladoResposta[]
  solicitacoesAgendamento SolicitacaoAgendamento[]
  materiaisFavoritos      MaterialFavorito[]
  cronogramaConclusoes    CronogramaConclusao[]
  tentativasBanco         TentativaQuestaoBanco[]
}

model Matricula {
  id          String          @id @default(cuid())
  estudanteId String
  turmaId     String
  status      StatusInscricao @default(PENDENTE)
  createdAt   DateTime        @default(now())

  estudante Estudante @relation(fields: [estudanteId], references: [id])
  turma     Turma     @relation(fields: [turmaId], references: [id])

  @@unique([estudanteId, turmaId])
  @@index([turmaId])
}

model Disciplina {
  id   String @id @default(cuid())
  nome String @unique

  turmaDisciplinas TurmaDisciplina[]
  monitorias       Monitoria[]
  materiais        Material[]
}

// Uma oferta de disciplina dentro de uma turma: quem leciona, que dia/horário
model TurmaDisciplina {
  id           String @id @default(cuid())
  turmaId      String
  disciplinaId String
  professorId  String
  diaSemana    String // ex: "Sábado 1", "Sábado 2", "Noturno Ter/Qui"
  horaInicio   String // "09:00"
  horaFim      String // "09:50"

  turma      Turma      @relation(fields: [turmaId], references: [id])
  disciplina Disciplina @relation(fields: [disciplinaId], references: [id])
  professor  User       @relation(fields: [professorId], references: [id])

  @@index([turmaId])
  @@index([professorId])
}

model Material {
  id         String   @id @default(cuid())
  titulo     String
  descricao  String?
  arquivoUrl String
  tipo       String   @default("OUTRO") // "SLIDE" | "EXERCICIO" | "VIDEO" | "OUTRO"
  aula       String? // ex: "Aula 3 — Funções do 2º grau"
  publico    Boolean  @default(false) // true = aparece em "Materiais gratuitos" no site público
  createdAt  DateTime @default(now())

  nucleoId String?
  nucleo   Nucleo? @relation(fields: [nucleoId], references: [id])

  disciplinaId String?
  disciplina   Disciplina? @relation(fields: [disciplinaId], references: [id])

  favoritos MaterialFavorito[]

  @@index([nucleoId])
  @@index([disciplinaId])
}

model MaterialFavorito {
  id          String   @id @default(cuid())
  materialId  String
  estudanteId String
  createdAt   DateTime @default(now())

  material  Material  @relation(fields: [materialId], references: [id])
  estudante Estudante @relation(fields: [estudanteId], references: [id])

  @@unique([materialId, estudanteId])
}

model Aviso {
  id        String   @id @default(cuid())
  titulo    String
  corpo     String
  createdAt DateTime @default(now())

  nucleoId String?
  nucleo   Nucleo? @relation(fields: [nucleoId], references: [id])
  turmaId  String?
  turma    Turma?  @relation(fields: [turmaId], references: [id])

  @@index([nucleoId])
  @@index([turmaId])
}

model Evento {
  id      String   @id @default(cuid())
  titulo  String
  data    DateTime
  local   String?
  publico Boolean  @default(true)

  nucleoId String?
  nucleo   Nucleo? @relation(fields: [nucleoId], references: [id])

  @@index([nucleoId])
}

// Prova/vestibular da rede (ex: UERJ, ENEM) — usado pra contagem regressiva no portal do aluno
model Prova {
  id   String   @id @default(cuid())
  nome String
  data DateTime

  nucleoId String?
  nucleo   Nucleo? @relation(fields: [nucleoId], references: [id])

  @@index([nucleoId])
}

// Depoimento/história de estudante ou professor, gerenciável pela coordenação, exibido na Home
model Depoimento {
  id           String   @id @default(cuid())
  nome         String
  curso        String?
  universidade String?
  fotoUrl      String?
  quote        String
  createdAt    DateTime @default(now())

  nucleoId String?
  nucleo   Nucleo? @relation(fields: [nucleoId], references: [id])

  @@index([nucleoId])
}

model Monitoria {
  id         String  @id @default(cuid())
  diaSemana  String
  horaInicio String
  horaFim    String
  materiais  String?
  link       String?
  global     Boolean @default(false)

  nucleoId String
  nucleo   Nucleo @relation(fields: [nucleoId], references: [id])

  turmaId String?
  turma   Turma?  @relation(fields: [turmaId], references: [id])

  professorId String?
  professor   User?   @relation(fields: [professorId], references: [id])

  disciplinaId String?
  disciplina   Disciplina? @relation(fields: [disciplinaId], references: [id])

  @@index([turmaId])
  @@index([nucleoId])
}

model Frequencia {
  id          String   @id @default(cuid())
  estudanteId String
  turmaId     String
  data        DateTime
  presente    Boolean

  estudante Estudante @relation(fields: [estudanteId], references: [id])
  turma     Turma     @relation(fields: [turmaId], references: [id])

  @@unique([estudanteId, turmaId, data])
}

model QuestaoBanco {
  id              String   @id @default(cuid())
  prova           String // "ENEM" | "UERJ"
  materia         String
  ano             Int?
  enunciado       String
  opcaoA          String
  opcaoB          String
  opcaoC          String
  opcaoD          String
  opcaoE          String?
  respostaCorreta String // "A" | "B" | "C" | "D" | "E"
  subtema         String? // visível só pra prof/coordenação, não pro aluno
  createdAt       DateTime @default(now())

  tentativas TentativaQuestaoBanco[]

  @@index([prova, materia])
}

// Cada resposta que o aluno dá no Banco de Questões (prática livre ou simulado)
// — é o que alimenta streak, meta diária, revisão de erros e desempenho.
model TentativaQuestaoBanco {
  id                String   @id @default(cuid())
  estudanteId       String
  questaoId         String
  respostaEscolhida String
  correta           Boolean
  createdAt         DateTime @default(now())

  estudante Estudante    @relation(fields: [estudanteId], references: [id])
  questao   QuestaoBanco @relation(fields: [questaoId], references: [id])

  @@index([estudanteId, createdAt])
  @@index([questaoId])
}

model Simulado {
  id        String   @id @default(cuid())
  nome      String
  data      DateTime
  gabarito  String // ex: "A,B,C,D,A,B,..." — questões 23 a 27 (língua estrangeira) ficam com "?" aqui
  createdAt DateTime @default(now())

  // Bloco de língua estrangeira (questões 23 a 27, padrão Uerj) — um gabarito
  // por idioma, já que cada aluno escolhe um só na hora da prova.
  gabaritoIngles   String? // 5 respostas, ex: "A,B,C,D,A"
  gabaritoEspanhol String?
  gabaritoFrances  String?

  nucleoId String
  nucleo   Nucleo @relation(fields: [nucleoId], references: [id])

  respostas SimuladoResposta[]

  @@index([nucleoId])
}

// Não depende de cadastro de aluno — vem direto do cartão-resposta (lido por
// IA ou digitado à mão), identificado só por nome + data de nascimento.
// Se bater com um Estudante cadastrado, o vínculo é guardado só de bônus
// (pra mostrar no perfil do aluno), mas nunca é obrigatório.
model SimuladoResposta {
  id                   String    @id @default(cuid())
  simuladoId           String
  estudanteId          String?
  nomeCompleto         String
  dataNascimento       DateTime?
  respostas            String // ex: "A,B,C,D,A,B,..."
  linguaEscolhida      String? // "Inglês" | "Espanhol" | "Francês" — bloco das questões 23 a 27
  nota                 Float?
  corrigidoManualmente Boolean   @default(false)
  fotoCartaoResposta   String? // foto do cartão-resposta físico, só de referência
  createdAt            DateTime  @default(now())

  simulado  Simulado   @relation(fields: [simuladoId], references: [id])
  estudante Estudante? @relation(fields: [estudanteId], references: [id])

  @@index([simuladoId, dataNascimento])
}

model FormularioCustom {
  id        String   @id @default(cuid())
  titulo    String
  descricao String?
  campos    String // JSON: [{ id, label, tipo, opcoes?, obrigatorio }]
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  nucleoId String
  nucleo   Nucleo @relation(fields: [nucleoId], references: [id])

  respostas FormularioResposta[]

  @@index([nucleoId])
}

model FormularioResposta {
  id           String   @id @default(cuid())
  formularioId String
  respostas    String // JSON: { [campoId]: valor }
  createdAt    DateTime @default(now())

  formulario FormularioCustom @relation(fields: [formularioId], references: [id])

  @@index([formularioId])
}

model ConteudoSite {
  id              String   @id @default(cuid())
  quemSomosTexto  String?
  contatoEmail    String?
  contatoTelefone String?
  contatoEndereco String?
  monitoriaTexto  String?
  cotasTexto      String?
  updatedAt       DateTime @updatedAt
}

// Fase 2 — ainda não usado nas telas
model TemaRedacao {
  id             String    @id @default(cuid())
  prova          String // "ENEM" | "UERJ"
  titulo         String
  textoMotivador String?
  prazoEnvio     DateTime?
  ativo          Boolean   @default(true)
  createdAt      DateTime  @default(now())

  criadoPorId String?
  criadoPor   User?   @relation("TemasCriados", fields: [criadoPorId], references: [id])

  redacoes Redacao[]

  @@index([prova])
}

model Redacao {
  id           String @id @default(cuid())
  estudanteId  String
  temaId       String
  textoEnviado String
  status       String @default("ENVIADA") // "ENVIADA" | "CORRIGIDA"

  // Notas por competência, em JSON: ENEM -> [{comp:1,nota:160}, ...] / UERJ -> [{criterio:"...",nota:...}]
  notasComponentes String?
  notaTotal        Float?
  comentarioGeral  String?
  // Marcações no próprio texto, em JSON: [{inicio:10,fim:25,comentario:"..."}]
  marcacoes        String?
  // Diagnóstico automático (IA) com base nos critérios da prova — visível só pra prof/coordenação
  diagnosticoIA    String?

  corrigidoPorId String?
  corrigidoPor   User?     @relation("RedacoesCorrigidas", fields: [corrigidoPorId], references: [id])
  corrigidoEm    DateTime?

  createdAt DateTime @default(now())

  estudante Estudante   @relation(fields: [estudanteId], references: [id])
  tema      TemaRedacao @relation(fields: [temaId], references: [id])

  @@index([estudanteId])
  @@index([temaId])
}
